{
  "manifest_version": 3,
  "name": "Clyr APP",
  "version": "1.0",

  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "alarms",
    "notifications"
  ],

  "host_permissions": [
    "<all_urls>",
    "https://*.supabase.co/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "dashboard.html"
  },

  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
